{
  "mcpServers": {
    "dosboxx-debugger": {
      "command": "tools/mcp_dosboxx.sh",
      "args": [
        "--total-budget", "400",
        "--exec-budget", "200",
        "--deadline-seconds", "3600",
        "--allowed-tools", "get_debug_status,get_cpu_state,get_current_instruction,read_memory,disassemble,set_breakpoint,delete_breakpoint,list_breakpoints,continue_execution,pause_execution,step_into,step_over",
        "--evidence-log", "/app/scratchpad/wolong-evidence.jsonl"
      ]
    }
  }
}
